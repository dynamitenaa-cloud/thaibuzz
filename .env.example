# ── 로컬 실행용 (.env.local 로 복사). 운영에서는 GitHub Secrets / Variables 에 넣으세요 ──

# [필수] Gemini 무료 키: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# 기본 gemini-2.5-flash. 무료 티어에서 쓸 수 있는 최신 flash 모델로 바꿔도 됨
GEMINI_MODEL=

# 사이트
NEXT_PUBLIC_SITE_URL=https://thaibuzz.pages.dev
NEXT_PUBLIC_SITE_NAME=ThaiBuzz
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# 수익화 / 분석 (비워두면 자동으로 숨김)
NEXT_PUBLIC_ADSENSE_ID=          # ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_GA_ID=               # G-XXXXXXX
NEXT_PUBLIC_SHOPEE_AFFILIATE_ID=

# 발행량 상한 (품질 유지 + 무료 쿼터 보호)
MAX_PER_RUN=3
MAX_PER_DAY=40

# IndexNow (Bing 등 즉시 색인 요청). 아무 영숫자 32자
INDEXNOW_KEY=
